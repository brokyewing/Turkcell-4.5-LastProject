# docker-compose icin ortam degiskenleri ORNEGI.
#
# Kullanim:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#   # sonra .env icindeki degerleri gercek/zorlu degerlerle degistir
#   docker compose up -d --build
#
# .env dosyasi .gitignore'da; gercek secret'lari ASLA repoya commit etme.
# Bu dosyadaki degerler bilerek zayif/ornektir.

# --- PostgreSQL ---
POSTGRES_DB=library_db
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me-db-password

# Spring servislerinin DB sifresi (postgres ile ayni olmali).
# Not: ayri tutuluyor ki yonetilen DB'ye gecince yalniz bu satir degissin.
SPRING_DATASOURCE_PASSWORD=change-me-db-password

# --- JWT ---
# En az 32 karakter (256 bit) rastgele deger. Uretmek icin:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-256-bit-secret-at-least-32-chars
