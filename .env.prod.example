# Üretim ortam değişkenleri ÖRNEĞİ.
#
#   Copy-Item .env.prod.example .env.prod      (veya: cp)
#   # değerleri doldur, sonra:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod GIT'E EKLENMEZ (.gitignore + .dockerignore). Değerleri asla commit etme.
# Sunucuda izinleri kısıtla: chmod 600 .env.prod

# --- PostgreSQL ---
POSTGRES_DB=library_db
POSTGRES_USER=library
# Güçlü bir değer üret: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
# Spring servislerinin DB parolası — postgres ile AYNI olmalı.
SPRING_DATASOURCE_PASSWORD=CHANGE-ME-strong-db-password

# --- JWT ---
# En az 32 karakter. Kısa verilirse gateway açılışta patlar (Keys.hmacShaKeyFor).
# Üret: openssl rand -base64 48
JWT_SECRET=CHANGE-ME-at-least-32-random-characters-long

# --- Demo seed ---
# Kütüphaneci (L1001) demo parolası. BOŞ bırakılırsa kütüphaneci hiç seed edilmez.
# ÜRETİMDE BOŞ BIRAK (önerilen) ya da güçlü bir değer ver — asla "librarian123" bırakma.
DEMO_LIBRARIAN_PASSWORD=

# --- Alan adı / TLS ---
# Gerçek alan adı (şemasız): otomatik HTTPS (Let's Encrypt). 80 ve 443 açık olmalı.
# DOMAIN=app.example.com
#
# Yerel deneme: düz HTTP. DİKKAT — port YAZILMAZ; Caddy konteynerde 80'de dinler,
# host portu WEB_HTTP_PORT ile eşlenir (aşağıda 8088). `http://localhost:8088`
# yazılırsa Caddy 8088'de dinlemeye çalışır, 80 boş kalır ve site açılmaz (ölçüldü).
DOMAIN=http://:80

# --- Yayınlanan host portları (konteyner içi portlar değil) ---
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# --- CORS ---
# Tek origin proxy kullanıldığı için normalde gerekmez. API'ye başka bir
# origin'den doğrudan erişilecekse virgülle ayrılmış liste ver.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- İmaj tabanları (ARM64 çok mimarili; değiştirmek gerekmez) ---
# JRE_IMAGE=eclipse-temurin:21-jre
# NODE_IMAGE=node:22-alpine
# CADDY_IMAGE=caddy:2-alpine
